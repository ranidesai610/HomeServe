
@model HomeServiceManagementSystem.Models.Booking

@{
    ViewData["Title"] = "Delete Booking";
}

<style>
    .delete-page {
        margin-top: 50px;
        margin-bottom: 60px;
    }

    .delete-card {
        background: white;
        border-radius: 24px;
        padding: 40px;
        box-shadow: 0 10px 35px rgba(0,0,0,0.08);
    }

    .warning-icon {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: #fff1f1;
        color: #dc3545;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 40px;
        margin: 0 auto 20px;
    }

    .page-title {
        font-weight: 800;
        color: #172033;
    }

    .warning-text {
        color: #6c757d;
        font-size: 16px;
    }

    .booking-summary {
        background: #f8f9fc;
        border-radius: 18px;
        padding: 25px;
        margin-top: 30px;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid #e5e7eb;
    }

        .summary-row:last-child {
            border-bottom: none;
        }

    .summary-label {
        color: #6c757d;
        font-weight: 600;
    }

    .summary-value {
        color: #172033;
        font-weight: 700;
        text-align: right;
    }

    .delete-btn {
        border-radius: 12px;
        padding: 11px 24px;
        font-weight: 700;
    }

    .cancel-btn {
        border-radius: 12px;
        padding: 11px 24px;
        font-weight: 600;
    }
</style>

<div class="container delete-page">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="delete-card">

                <div class="text-center">

                    <div class="warning-icon">
                        ⚠️
                    </div>

                    <h1 class="page-title">
                        Delete Booking?
                    </h1>

                    <p class="warning-text mt-2">
                        Are you sure you want to delete this booking?
                        This action cannot be undone.
                    </p>

                </div>

                <div class="booking-summary">

                    <div class="summary-row">
                        <span class="summary-label">Booking ID</span>
                        <span class="summary-value">#@Model.Id</span>
                    </div>

                    <div class="summary-row">
                        <span class="summary-label">Customer</span>
                        <span class="summary-value">@Model.User?.Name</span>
                    </div>

                    <div class="summary-row">
                        <span class="summary-label">Service</span>
                        <span class="summary-value">@Model.Service?.Name</span>
                    </div>

                    <div class="summary-row">
                        <span class="summary-label">Provider</span>
                        <span class="summary-value">@Model.ServiceProvider?.User?.Name</span>
                    </div>

                    <div class="summary-row">
                        <span class="summary-label">Date</span>
                        <span class="summary-value">
                            @Model.BookingDate.ToString("dd MMM yyyy")
                        </span>
                    </div>

                    <div class="summary-row">
                        <span class="summary-label">Time</span>
                        <span class="summary-value">@Model.BookingTime</span>
                    </div>

                    <div class="summary-row">
                        <span class="summary-label">Status</span>
                        <span class="summary-value">@Model.Status</span>
                    </div>

                    <div class="summary-row">
                        <span class="summary-label">Amount</span>
                        <span class="summary-value">
                            ₹@Model.TotalAmount.ToString("N2")
                        </span>
                    </div>

                </div>

                <div class="d-flex justify-content-center gap-3 mt-4">

                    <a asp-action="Index"
                       class="btn btn-secondary cancel-btn">
                        ← Cancel
                    </a>

                    <form asp-action="Delete" method="post">

                        <input type="hidden" asp-for="Id" />

                        <button type="submit"
                                class="btn btn-danger delete-btn">
                            🗑 Delete Booking
                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

