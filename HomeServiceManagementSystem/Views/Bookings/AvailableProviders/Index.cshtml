@model IEnumerable<HomeServiceManagementSystem.Models.ServiceProvider>

@{
    ViewData["Title"] = "Available Providers";
}

<style>
    .providers-page {
        margin-top: 40px;
        margin-bottom: 60px;
    }

    .providers-header {
        background: linear-gradient(135deg, #0d6efd, #4f8df7);
        color: white;
        border-radius: 24px;
        padding: 40px;
        margin-bottom: 35px;
    }

    .providers-header h1 {
        font-weight: 800;
    }

    .provider-card {
        background: white;
        border-radius: 20px;
        padding: 28px;
        height: 100%;
        box-shadow: 0 8px 28px rgba(0, 0, 0, 0.07);
        transition: 0.3s;
    }

    .provider-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.10);
    }

    .provider-icon {
        width: 60px;
        height: 60px;
        border-radius: 18px;
        background: #eaf2ff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        margin-bottom: 18px;
    }

    .provider-name {
        font-size: 21px;
        font-weight: 700;
        color: #172033;
    }

    .provider-info {
        color: #6c757d;
        margin-top: 8px;
    }

    .available-badge {
        display: inline-block;
        background: #e8f7ee;
        color: #198754;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
    }

    .select-btn {
        width: 100%;
        border-radius: 10px;
        padding: 11px;
        font-weight: 600;
        margin-top: 20px;
    }
</style>

<div class="container providers-page">

    <div class="providers-header">
        <h1>Available Service Providers</h1>

        <p class="mb-0 mt-2">
            Choose a professional provider for your selected service.
        </p>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">

            <div style="font-size: 50px;">
                😔
            </div>

            <h3 class="fw-bold mt-3">
                No providers available
            </h3>

            <p class="text-muted">
                No provider is currently available for the selected
                service and time.
            </p>

            <a asp-controller="CustomerServices"
               asp-action="Index"
               class="btn btn-primary">
                ← Browse Services
            </a>

        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var provider in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="provider-card">

                        <div class="provider-icon">
                            👨‍🔧
                        </div>

                        <div class="provider-name">
                            @(provider.User?.Name ?? "Service Provider")
                        </div>

                        <div class="provider-info">
                            📞 @provider.Phone
                        </div>

                        <div class="provider-info">
                            📍 @provider.Address
                        </div>

                        <div class="mt-3">

                            @if (provider.IsAvailable)
                            {
                                <span class="available-badge">
                                    ✓ Available
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Currently Unavailable
                                </span>
                            }

                        </div>

      <a asp-controller="Bookings"
   asp-action="SelectProvider"
   asp-route-providerId="@provider.Id"
   asp-route-serviceId="@ViewBag.ServiceId"
   asp-route-bookingDate="@ViewBag.BookingDate"
   asp-route-bookingTime="@ViewBag.BookingTime"
   asp-route-description="@ViewBag.Description"
   class="btn btn-primary">
    Select Provider →
</a>

                    </div>

                </div>
            }
        </div>
    }

</div>