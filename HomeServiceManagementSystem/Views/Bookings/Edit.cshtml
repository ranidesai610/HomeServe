
@model HomeServiceManagementSystem.Models.Booking

@{
    ViewData["Title"] = "Edit Booking";
}

<style>
    .edit-page {
        margin-top: 40px;
        margin-bottom: 60px;
    }

    .edit-header {
        background: linear-gradient(135deg, #0d6efd, #4f8df7);
        color: white;
        border-radius: 24px;
        padding: 35px;
        margin-bottom: 30px;
    }

        .edit-header h1 {
            font-weight: 800;
        }

    .booking-card {
        background: white;
        border-radius: 22px;
        padding: 30px;
        box-shadow: 0 8px 30px rgba(0,0,0,0.08);
        margin-bottom: 25px;
    }

    .card-title {
        font-size: 20px;
        font-weight: 800;
        color: #172033;
        margin-bottom: 20px;
    }

    .info-box {
        background: #f5f8fc;
        border-radius: 14px;
        padding: 15px 18px;
        margin-bottom: 12px;
    }

    .info-label {
        color: #6c757d;
        font-size: 13px;
        font-weight: 600;
    }

    .info-value {
        color: #172033;
        font-weight: 700;
        margin-top: 3px;
    }

    .form-control,
    .form-select {
        border-radius: 10px;
        padding: 11px 14px;
    }

    .action-btn {
        border-radius: 11px;
        padding: 11px 22px;
        font-weight: 700;
    }
</style>

<div class="container edit-page">

    <div class="edit-header">

        <h1>✏️ Edit Booking</h1>

        <p class="mb-0 mt-2">
            Update the booking details and status.
        </p>

    </div>


    <div class="row">

        <div class="col-lg-5">

            <div class="booking-card">

                <div class="card-title">
                    👤 Customer & Service
                </div>

                <div class="info-box">

                    <div class="info-label">
                        Customer
                    </div>

                    <div class="info-value">
                        @Model.User?.Name
                    </div>

                </div>

                <div class="info-box">

                    <div class="info-label">
                        Customer Email
                    </div>

                    <div class="info-value">
                        @Model.User?.Email
                    </div>

                </div>

                <div class="info-box">

                    <div class="info-label">
                        Service
                    </div>

                    <div class="info-value">
                        @Model.Service?.Name
                    </div>

                </div>

                <div class="info-box">

                    <div class="info-label">
                        Service Provider
                    </div>

                    <div class="info-value">
                        @Model.ServiceProvider?.User?.Name
                    </div>

                </div>

                <div class="info-box">

                    <div class="info-label">
                        Booking ID
                    </div>

                    <div class="info-value">
                        #@Model.Id
                    </div>

                </div>

            </div>

        </div>


        <div class="col-lg-7">

            <div class="booking-card">

                <div class="card-title">
                    📝 Booking Information
                </div>

                <form asp-action="Edit" method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <input type="hidden"
                           asp-for="Id" />

                    <div class="mb-3">

                        <label asp-for="BookingDate"
                               class="form-label fw-semibold">
                            Booking Date
                        </label>

                        <input asp-for="BookingDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="BookingDate"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="mb-3">

                        <label asp-for="BookingTime"
                               class="form-label fw-semibold">
                            Booking Time
                        </label>

                        <input asp-for="BookingTime"
                               type="text"
                               class="form-control"
                               placeholder="Example: 10:30 AM" />

                        <span asp-validation-for="BookingTime"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="mb-3">

                        <label asp-for="Status"
                               class="form-label fw-semibold">
                            Booking Status
                        </label>

                        <select asp-for="Status"
                                class="form-select">

                            <option value="Pending">
                                Pending
                            </option>

                            <option value="Confirmed">
                                Confirmed
                            </option>

                            <option value="In Progress">
                                In Progress
                            </option>

                            <option value="Completed">
                                Completed
                            </option>

                            <option value="Cancelled">
                                Cancelled
                            </option>

                            <option value="Rejected">
                                Rejected
                            </option>

                        </select>

                        <span asp-validation-for="Status"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="mb-3">

                        <label asp-for="TotalAmount"
                               class="form-label fw-semibold">
                            Total Amount
                        </label>

                        <input asp-for="TotalAmount"
                               type="number"
                               step="0.01"
                               class="form-control" />

                        <span asp-validation-for="TotalAmount"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="mb-4">

                        <label asp-for="Description"
                               class="form-label fw-semibold">
                            Service Description
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Enter service description"></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary action-btn">
                            💾 Save Changes
                        </button>

                        <a asp-action="Details"
                           asp-route-id="@Model.Id"
                           class="btn btn-outline-secondary action-btn">
                            Cancel
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
