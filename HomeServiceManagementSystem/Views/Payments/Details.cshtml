@model HomeServiceManagementSystem.Models.Payment

@{
    ViewData["Title"] = "Payment Successful";
}

<style>
    .payment-page {
        margin-top: 40px;
        margin-bottom: 60px;
    }

    .success-header {
        background: linear-gradient(135deg, #198754, #43b581);
        color: white;
        border-radius: 24px;
        padding: 45px;
        text-align: center;
        margin-bottom: 30px;
    }

    .success-icon {
        width: 80px;
        height: 80px;
        background: rgba(255,255,255,0.18);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        font-size: 40px;
    }

    .success-header h1 {
        font-weight: 800;
    }

    .payment-card {
        background: white;
        border-radius: 22px;
        padding: 30px;
        box-shadow: 0 8px 30px rgba(0,0,0,0.08);
        margin-bottom: 25px;
    }

    .card-title {
        font-size: 20px;
        font-weight: 800;
        color: #172033;
        margin-bottom: 20px;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        padding: 14px 0;
        border-bottom: 1px solid #eef1f5;
    }

        .info-row:last-child {
            border-bottom: none;
        }

    .info-label {
        color: #6c757d;
        font-weight: 600;
    }

    .info-value {
        color: #172033;
        font-weight: 700;
        text-align: right;
    }

    .paid-badge {
        display: inline-block;
        background: #d1e7dd;
        color: #0f5132;
        padding: 7px 15px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 700;
    }

    .amount-box {
        background: #e9f7ef;
        border-radius: 18px;
        padding: 25px;
        text-align: center;
    }

    .amount-label {
        color: #6c757d;
        font-weight: 600;
    }

    .amount {
        color: #198754;
        font-size: 34px;
        font-weight: 800;
        margin-top: 5px;
    }

    .action-btn {
        border-radius: 12px;
        padding: 12px 22px;
        font-weight: 700;
    }
</style>

<div class="container payment-page">

    <div class="success-header">

        <div class="success-icon">
            ✓
        </div>

        <h1>Payment Successful!</h1>

        <p class="mb-0 mt-2">
            Your payment has been recorded successfully.
        </p>

    </div>


    <div class="row">

        <div class="col-lg-7">

            <div class="payment-card">

                <div class="card-title">
                    💳 Payment Information
                </div>

                <div class="info-row">

                    <span class="info-label">
                        Payment ID
                    </span>

                    <span class="info-value">
                        #@Model.Id
                    </span>

                </div>

                <div class="info-row">

                    <span class="info-label">
                        Payment Method
                    </span>

                    <span class="info-value">
                        @Model.PaymentMethod
                    </span>

                </div>

                <div class="info-row">

                    <span class="info-label">
                        Payment Status
                    </span>

                    <span class="info-value">

                        <span class="paid-badge">
                            @Model.PaymentStatus
                        </span>

                    </span>

                </div>

                <div class="info-row">

                    <span class="info-label">
                        Payment Date
                    </span>

                    <span class="info-value">
                        @Model.PaymentDate.ToString("dd MMM yyyy, hh:mm tt")
                    </span>

                </div>

            </div>


            <div class="payment-card">

                <div class="card-title">
                    🏠 Booking Information
                </div>

                <div class="info-row">

                    <span class="info-label">
                        Booking ID
                    </span>

                    <span class="info-value">
                        #@Model.BookingId
                    </span>

                </div>

                <div class="info-row">

                    <span class="info-label">
                        Customer
                    </span>

                    <span class="info-value">
                        @Model.Booking?.User?.Name
                    </span>

                </div>

                <div class="info-row">

                    <span class="info-label">
                        Service
                    </span>

                    <span class="info-value">
                        @Model.Booking?.Service?.Name
                    </span>

                </div>

                <div class="info-row">

                    <span class="info-label">
                        Provider
                    </span>

                    <span class="info-value">
                        @Model.Booking?.ServiceProvider?.User?.Name
                    </span>

                </div>

            </div>

        </div>


        <div class="col-lg-5">

            <div class="payment-card">

                <div class="card-title">
                    💰 Payment Summary
                </div>

                <div class="amount-box">

                    <div class="amount-label">
                        Total Paid
                    </div>

                    <div class="amount">
                        ₹@Model.Amount.ToString("N2")
                    </div>

                </div>

            </div>


            <div class="payment-card">

                <a asp-controller="Bookings"
                   asp-action="Details"
                   asp-route-id="@Model.BookingId"
                   class="btn btn-primary action-btn w-100">

                    ← Back to Booking

                </a>
                <a asp-controller="Invoices"
                   asp-action="Details"
                   asp-route-id="@Model.Booking.Invoice?.Id"
                   class="btn btn-primary">
                    🧾 View Invoice
                </a>

                <a asp-controller="Bookings"
                   asp-action="Index"
                   class="btn btn-outline-secondary action-btn w-100 mt-3">

                    📋 My Bookings

                </a>

            </div>

        </div>

    </div>

</div>