@model IEnumerable<HomeServiceManagementSystem.Models.ProviderAvailability>

@{
    ViewData["Title"] = "Provider Availability";
}

<div class="container py-5">

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row
        justify-content-between align-items-md-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">Provider Availability</h2>
            <p class="text-muted mb-0">
                Manage weekly working schedules for service providers.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary px-4 mt-3 mt-md-0">
            + Add Availability
        </a>

    </div>

    <!-- Availability Table -->
    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-0">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Provider</th>
                                <th>Day</th>
                                <th>Start Time</th>
                                <th>End Time</th>
                                <th>Status</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <!-- Provider -->
                                    <td class="ps-4">

                                        <div class="fw-semibold">
                                            @(item.ServiceProvider?.User?.Name
                                                ?? "Unknown Provider")
                                        </div>

                                        <small class="text-muted">
                                            Provider ID: @item.ServiceProviderId
                                        </small>

                                    </td>

                                    <!-- Day -->
                                    <td>
                                        <span class="badge bg-primary-subtle
                                            text-primary px-3 py-2">
                                            @item.DayOfWeek
                                        </span>
                                    </td>

                                    <!-- Start Time -->
                                    <td>
                                        <span class="fw-semibold">
                                            @item.StartTime
                                        </span>
                                    </td>

                                    <!-- End Time -->
                                    <td>
                                        <span class="fw-semibold">
                                            @item.EndTime
                                        </span>
                                    </td>

                                    <!-- Status -->
                                    <td>
                                        @if (item.IsAvailable)
                                        {
                                            <span class="badge bg-success-subtle
                                                text-success px-3 py-2">
                                                Available
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle
                                                text-danger px-3 py-2">
                                                Not Available
                                            </span>
                                        }
                                    </td>

                                    <!-- Actions -->
                                    <td class="text-end pe-4">

                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary me-1">
                                            Edit
                                        </a>

                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-secondary me-1">
                                            Details
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            Delete
                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <!-- Empty State -->

                <div class="text-center py-5">

                    <div class="fs-1 mb-3">
                        🕒
                    </div>

                    <h5 class="fw-bold">
                        No availability schedules found
                    </h5>

                    <p class="text-muted">
                        Add a weekly schedule for a provider to get started.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary px-4">
                        + Add Availability
                    </a>

                </div>
            }

        </div>

    </div>

</div>