@model HomeServiceManagementSystem.Models.ServiceProvider

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this service provider?</h3>

<div>
    <h4>Service Provider</h4>
    <hr />

      <dl class="row">

        <dt class="col-sm-2">
            User ID
        </dt>
        <dd class="col-sm-10">
            @Model.UserId
        </dd>

        <dt class="col-sm-2">
            User Name
        </dt>
        <dd class="col-sm-10">
            @Model.User?.Name
        </dd>

        <dt class="col-sm-2">
            Role
        </dt>
        <dd class="col-sm-10">
            @Model.User?.Role
        </dd>

        <dt class="col-sm-2">
            Service Type
        </dt>
      

        <dt class="col-sm-2">
            Phone
        </dt>
        <dd class="col-sm-10">
            @Model.Phone
        </dd>

        <dt class="col-sm-2">
            Address
        </dt>
        <dd class="col-sm-10">
            @Model.Address
        </dd>

        <dt class="col-sm-2">
            Approved
        </dt>
        <dd class="col-sm-10">
            @Model.IsApproved
        </dd>

        <dt class="col-sm-2">
            Available
        </dt>
        <dd class="col-sm-10">
            @Model.IsAvailable
        </dd>

    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />

        <input type="submit" value="Delete" class="btn btn-danger" /> |

        <a asp-action="Index">Back to List</a>
    </form>
    

</div>
