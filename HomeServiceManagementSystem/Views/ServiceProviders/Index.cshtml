@model IEnumerable<HomeServiceManagementSystem.Models.ServiceProvider>

@{
    ViewData["Title"] = "Service Providers";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Service Providers</h2>
            <p class="text-muted mb-0">
                Manage providers and the services they offer.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Add Provider
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Provider</th>
                            <th>Email</th>
                            <th>Services</th>
                            <th>Phone</th>
                            <th>Approved</th>
                            <th>Available</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var provider in Model)
                        {
                            <tr>

                                <td>
                                    <div class="fw-semibold">
                                        @(provider.User?.Name ?? "N/A")
                                    </div>
                                </td>

                                <td>
                                    @(provider.User?.Email ?? "N/A")
                                </td>

                                <td>
                                    @if (provider.ProviderServices != null &&
                                         provider.ProviderServices.Any())
                                    {
                                        foreach (var ps in provider.ProviderServices)
                                        {
                                            <span class="badge bg-light text-dark border me-1 mb-1">
                                                @ps.Service?.Name
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No services assigned
                                        </span>
                                    }
                                </td>

                                <td>
                                    @provider.Phone
                                </td>

                                <td>
                                    @if (provider.IsApproved)
                                    {
                                        <span class="badge bg-success">
                                            Approved
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Pending
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (provider.IsAvailable)
                                    {
                                        <span class="badge bg-success">
                                            Available
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Unavailable
                                        </span>
                                    }
                                </td>

                                <td class="text-end">

                                    <a asp-action="Details"
                                       asp-route-id="@provider.Id"
                                       class="btn btn-sm btn-outline-info">
                                        Details
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@provider.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@provider.Id"
                                       class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>