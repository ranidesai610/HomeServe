@model HomeServiceManagementSystem.Models.ServiceProvider

@{
    ViewData["Title"] = "Delete Provider";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold text-danger">Delete Provider</h2>
        <p class="text-muted">
            Please confirm that you want to delete this provider.
        </p>
    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <div class="alert alert-warning">
                <strong>Warning:</strong>
                This action cannot be undone.
            </div>


            <h5 class="fw-bold mb-3">
                Provider Information
            </h5>

            <div class="row mb-4">

                <div class="col-md-6">

                    <p>
                        <strong>Name:</strong>
                        @(Model.User?.Name ?? "N/A")
                    </p>

                    <p>
                        <strong>Email:</strong>
                        @(Model.User?.Email ?? "N/A")
                    </p>

                    <p>
                        <strong>Phone:</strong>
                        @Model.Phone
                    </p>

                </div>

                <div class="col-md-6">

                    <p>
                        <strong>Address:</strong>
                        @Model.Address
                    </p>

                    <p>
                        <strong>Status:</strong>

                        @if (Model.IsApproved)
                        {
                            <span class="badge bg-success">
                                Approved
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">
                                Not Approved
                            </span>
                        }

                    </p>

                </div>

            </div>


            <h5 class="fw-bold mb-3">
                Services
            </h5>

            @if (Model.ProviderServices != null &&
                 Model.ProviderServices.Any())
            {
                foreach (var ps in Model.ProviderServices)
                {
                    <span class="badge bg-light text-dark border me-2 mb-2 p-2">
                        @ps.Service?.Name
                    </span>
                }
            }
            else
            {
                <p class="text-muted">
                    No services assigned.
                </p>
            }


            <hr class="my-4" />


            <form asp-action="Delete">

                <input type="hidden"
                       asp-for="Id" />

                <button type="submit"
                        class="btn btn-danger px-4">
                    Delete Provider
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>