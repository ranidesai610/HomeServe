@{
    ViewData["Title"] = "Customer Dashboard";
}

<div class="container mt-4">

    <h1 class="mb-2">Customer Dashboard</h1>

    <p class="text-muted">
        Welcome to the Home Service Management System
    </p>

    <hr />

    <div class="row mt-4">

        <div class="col-md-4 mb-3">
            <div class="card shadow h-100">
                <div class="card-body">
                    <h4>Services</h4>
                    <p>View available home services.</p>
                    <a asp-controller="CustomerServices"
                       asp-action="Index"
                       class="btn btn-primary">
                        View Services
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow h-100">
                <div class="card-body">
                    <h4>My Bookings</h4>
                    <p>View your service bookings.</p>

                    <a asp-controller="Bookings"
                       asp-action="Index"
                       class="btn btn-success">
                        My Bookings
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow h-100">
                <div class="card-body">
                    <h4>Profile</h4>
                    <p>View your account information.</p>

                    <a asp-controller="Customer"
                       asp-action="Profile"
                       class="btn btn-secondary">
                        My Profile
                    </a>
                </div>
            </div>
        </div>
        <div class="text-center mt-4">

            <a asp-controller="Customer"
               asp-action="Logout"
               class="btn btn-danger">
                🚪 Logout
            </a>

        </div>


    </div>

</div>