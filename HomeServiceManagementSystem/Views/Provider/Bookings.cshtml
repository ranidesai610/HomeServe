@model IEnumerable<HomeServiceManagementSystem.Models.Booking>

@{
    ViewData["Title"] = "Provider Bookings";
}

<style>
    .provider-bookings-page {
        margin-top: 40px;
        margin-bottom: 60px;
    }

    .page-header {
        background: linear-gradient(135deg, #198754, #43b581);
        color: white;
        border-radius: 24px;
        padding: 40px;
        margin-bottom: 30px;
    }

    .booking-card {
        background: white;
        border-radius: 20px;
        padding: 25px;
        margin-bottom: 20px;
        box-shadow: 0 8px 28px rgba(0,0,0,0.07);
    }

    .customer-name {
        font-size: 21px;
        font-weight: 800;
        color: #172033;
    }

    .service-name {
        color: #198754;
        font-weight: 700;
        margin-top: 5px;
    }

    .booking-info {
        color: #555;
        margin-top: 8px;
    }

    .status-badge {
        display: inline-block;
        padding: 7px 14px;
        border-radius: 20px;
        background: #fff3cd;
        color: #856404;
        font-size: 13px;
        font-weight: 700;
    }

    .amount {
        font-size: 20px;
        font-weight: 800;
        color: #198754;
    }

    .empty-box {
        background: white;
        border-radius: 22px;
        padding: 60px 20px;
        text-align: center;
        box-shadow: 0 8px 28px rgba(0,0,0,0.07);
    }

    .empty-icon {
        font-size: 55px;
    }
</style>

<div class="container provider-bookings-page">

    <div class="page-header">

        <h1 class="fw-bold">
            📋 Customer Bookings
        </h1>

        <p class="mb-0 mt-2">
            View and manage bookings assigned to you.
        </p>

    </div>

    @if (!Model.Any())
    {
        <div class="empty-box">

            <div class="empty-icon">
                📅
            </div>

            <h3 class="fw-bold mt-3">
                No bookings yet
            </h3>

            <p class="text-muted">
                You don't have any customer bookings at the moment.
            </p>

        </div>
    }
    else
    {
        @foreach (var booking in Model)
        {
            <div class="booking-card">

                <div class="row align-items-center">

                    <div class="col-md-4">

                        <div class="customer-name">
                            👤 @booking.User?.Name
                        </div>

                        <div class="service-name">
                            🔧 @booking.Service?.Name
                        </div>

                    </div>

                    <div class="col-md-3">

                        <div class="booking-info">
                            📅 @booking.BookingDate.ToString("dd MMM yyyy")
                        </div>

                        <div class="booking-info">
                            🕐 @booking.BookingTime
                        </div>

                    </div>

                    <div class="col-md-2">

                        <div class="status-badge">
                            @booking.Status
                        </div>

                        <div class="amount mt-2">
                            ₹@booking.TotalAmount.ToString("N2")
                        </div>
                        @if (booking.Status == "Pending")
                        {
                            <div class="mt-3">

                                <form asp-controller="Provider"
                                      asp-action="AcceptBooking"
                                      method="post"
                                      class="d-inline">

                                    <input type="hidden"
                                           name="id"
                                           value="@booking.Id" />

                                    <button type="submit"
                                            class="btn btn-success btn-sm">
                                        ✅ Accept
                                    </button>

                                </form>

                                <form asp-controller="Provider"
                                      asp-action="RejectBooking"
                                      method="post"
                                      class="d-inline">

                                    <input type="hidden"
                                           name="id"
                                           value="@booking.Id" />

                                    <button type="submit"
                                            class="btn btn-danger btn-sm">
                                        ❌ Reject
                                    </button>

                                </form>

                            </div>
                        }

                        @if (booking.Status == "Confirmed")
                        {
                            <div class="mt-3">

                                <form asp-controller="Provider"
                                      asp-action="StartBooking"
                                      method="post"
                                      class="d-inline">

                                    <input type="hidden"
                                           name="id"
                                           value="@booking.Id" />

                                    <button type="submit"
                                            class="btn btn-warning btn-sm">
                                        🔧 Start Service
                                    </button>

                                </form>

                                <form asp-controller="Provider"
                                      asp-action="CancelBooking"
                                      method="post"
                                      class="d-inline">

                                    <input type="hidden"
                                           name="id"
                                           value="@booking.Id" />

                                    <button type="submit"
                                            class="btn btn-danger btn-sm">
                                        ❌ Cancel
                                    </button>

                                </form>

                            </div>
                        }

                        @if (booking.Status == "In Progress")
                        {
                            <div class="mt-3">

                                <form asp-controller="Provider"
                                      asp-action="CompleteBooking"
                                      method="post"
                                      class="d-inline">

                                    <input type="hidden"
                                           name="id"
                                           value="@booking.Id" />

                                    <button type="submit"
                                            class="btn btn-success btn-sm">
                                        ✅ Complete Service
                                    </button>

                                </form>

                            </div>
                        }


                    </div>

                    <div class="col-md-3">

                        <div class="booking-info">
                            📍 @booking.Address?.City
                        </div>

                        <div class="booking-info">
                            📞 @booking.User?.Email
                        </div>

                    </div>

                </div>

            </div>
        }
    }

</div>