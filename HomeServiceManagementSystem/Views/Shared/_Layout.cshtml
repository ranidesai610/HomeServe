<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - HomeServe</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <style>

            body {
                margin: 0;
                background-color: #f7f9fc;
                color: #172033;
                font-family: "Segoe UI", Arial, sans-serif;
            }

            /* NAVBAR */

            .navbar {
                background: white !important;
                padding: 14px 0;
                box-shadow: 0 3px 15px rgba(0,0,0,0.06);
            }

            .brand {
                font-size: 25px;
                font-weight: 800;
                color: #0d6efd !important;
                text-decoration: none;
            }

            .brand-icon {
                width: 40px;
                height: 40px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                background: #eaf2ff;
                border-radius: 12px;
                margin-right: 8px;
            }

            .nav-link {
                color: #4d5666 !important;
                font-weight: 600;
                margin: 0 8px;
                transition: 0.2s;
            }

                .nav-link:hover {
                    color: #0d6efd !important;
                }

            .login-btn {
                border-radius: 10px;
                padding: 9px 20px;
                font-weight: 600;
            }

            .register-btn {
                border-radius: 10px;
                padding: 9px 20px;
                font-weight: 600;
            }

            /* FOOTER */

            .footer {
                background: #172033;
                color: white;
                margin-top: 70px;
                padding: 50px 0 25px;
            }

            .footer-brand {
                font-size: 24px;
                font-weight: 800;
                color: white;
            }

            .footer-text {
                color: #b9c1cf;
                line-height: 1.7;
            }

            .footer-title {
                font-weight: 700;
                margin-bottom: 18px;
            }

            .footer-link {
                display: block;
                color: #b9c1cf;
                text-decoration: none;
                margin-bottom: 10px;
                transition: 0.2s;
            }

                .footer-link:hover {
                    color: white;
                }

            .footer-bottom {
                border-top: 1px solid rgba(255,255,255,0.1);
                margin-top: 35px;
                padding-top: 20px;
                color: #9da7b8;
                font-size: 14px;
            }

    </style>

</head>

<body>

    <!-- NAVBAR -->

    <nav class="navbar navbar-expand-lg">

        <div class="container">

            <a class="brand"
               asp-controller="Home"
               asp-action="Index">

                <span class="brand-icon">🏠</span>
                HomeServe

            </a>


            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar">

                <span class="navbar-toggler-icon"></span>

            </button>


            <div class="collapse navbar-collapse" id="mainNavbar">

                <ul class="navbar-nav ms-auto align-items-lg-center">

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">

                            Home

                        </a>

                    </li>


                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="CustomerServices"
                           asp-action="Index">

                            Services

                        </a>

                    </li>


                    <li class="nav-item">

                        <a class="nav-link"
                           href="#how-it-works">

                            How It Works

                        </a>

                    </li>


                    <li class="nav-item ms-lg-2">

                        <a class="btn btn-outline-primary login-btn"
                           asp-controller="Login"
                           asp-action="Index">

                            Login

                        </a>

                    </li>


                    <li class="nav-item ms-lg-2">

                        <a class="btn btn-primary register-btn"
                           asp-controller="Login"
                           asp-action="Index">

                            Get Started

                        </a>

                    </li>

                </ul>

            </div>

        </div>

    </nav>


    <!-- PAGE CONTENT -->

    <main>

        @RenderBody()

    </main>


    <!-- FOOTER -->

    <footer class="footer">

        <div class="container">

            <div class="row g-4">

                <div class="col-lg-5">

                    <div class="footer-brand">

                        🏠 HomeServe

                    </div>

                    <p class="footer-text mt-3">

                        Your trusted platform for booking reliable
                        home services from approved professionals.

                    </p>

                </div>


                <div class="col-6 col-lg-2">

                    <div class="footer-title">

                        Quick Links

                    </div>

                    <a class="footer-link"
                       asp-controller="Home"
                       asp-action="Index">

                        Home

                    </a>

                    <a class="footer-link"
                       asp-controller="CustomerServices"
                       asp-action="Index">

                        Services

                    </a>

                    <a class="footer-link"
                       asp-controller="Login"
                       asp-action="Index">

                        Login

                    </a>

                </div>


                <div class="col-6 col-lg-2">

                    <div class="footer-title">

                        Services

                    </div>

                    <span class="footer-link">Plumbing</span>
                    <span class="footer-link">Electrical</span>
                    <span class="footer-link">AC Repair</span>
                    <span class="footer-link">Cleaning</span>

                </div>


                <div class="col-lg-3">

                    <div class="footer-title">

                        Contact

                    </div>

                    <div class="footer-text">

                        📧 support@homeserve.com

                        <br />

                        📞 +91 98765 43210

                        <br />

                        📍 Gujarat, India

                    </div>

                </div>

            </div>


            <div class="footer-bottom text-center">

                © 2026 HomeServe. All rights reserved.

            </div>

        </div>

    </footer>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>