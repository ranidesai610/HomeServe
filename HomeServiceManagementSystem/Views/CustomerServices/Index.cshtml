@model IEnumerable<HomeServiceManagementSystem.Models.Service>

@{
    ViewData["Title"] = "Services";
}

<style>
    .services-header {
        background: linear-gradient(135deg, #0d6efd, #4f8df7);
        color: white;
        border-radius: 24px;
        padding: 45px;
        margin-top: 30px;
        margin-bottom: 45px;
        box-shadow: 0 12px 30px rgba(13, 110, 253, 0.18);
    }

    .services-header h1 {
        font-weight: 800;
        font-size: 42px;
    }

    .services-header p {
        font-size: 17px;
        opacity: 0.95;
        max-width: 700px;
    }

    .service-card {
        background: white;
        border-radius: 20px;
        padding: 28px;
        height: 100%;
        border: none;
        box-shadow: 0 5px 25px rgba(0,0,0,0.06);
        transition: 0.3s;
    }

    .service-card:hover {
        transform: translateY(-7px);
        box-shadow: 0 15px 35px rgba(0,0,0,0.10);
    }

    .service-icon {
        width: 65px;
        height: 65px;
        border-radius: 18px;
        background: #eaf2ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        margin-bottom: 20px;
    }

    .service-name {
        font-size: 21px;
        font-weight: 700;
        color: #172033;
    }

    .service-description {
        color: #6c757d;
        min-height: 55px;
    }

    .service-price {
        color: #0d6efd;
        font-size: 22px;
        font-weight: 800;
    }

    .category-badge {
        background: #eef4ff;
        color: #0d6efd;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
    }

    .book-btn {
        border-radius: 10px;
        font-weight: 600;
        padding: 10px 18px;
    }
</style>


<div class="container">

    <!-- Header -->

    <div class="services-header">

        <h1>
            Find the Right Service for Your Home
        </h1>

        <p class="mt-3 mb-0">
            Browse our professional home services, check pricing,
            and choose the service that fits your needs.
        </p>

    </div>


    <!-- Services -->

    <div class="row g-4">

        @foreach (var service in Model)
        {
            string icon = service.Name switch
            {
                "Plumbing" => "🔧",
                "Electrical" => "⚡",
                "AC Repair" => "❄️",
                "Home Cleaning" => "🧹",
                "Painting" => "🎨",
                "Carpentry" => "🪚",
                "Pest Control" => "🐜",
                "Appliance Repair" => "🔌",
                _ => "🏠"
            };

            <div class="col-md-6 col-lg-4">

                <div class="service-card">

                    <div class="service-icon">
                        @icon
                    </div>

                    <div class="mb-3">

                        <span class="category-badge">

                            @(service.ServiceCategory?.Name ?? "Home Service")

                        </span>

                    </div>

                    <h3 class="service-name">
                        @service.Name
                    </h3>

                    <p class="service-description mt-3">
                        @service.Description
                    </p>

                    <div class="d-flex justify-content-between align-items-center mt-4">

                        <div>
                            <small class="text-muted">
                                Starting from
                            </small>

                            <div class="service-price">
                                ₹@service.Price.ToString("0")
                            </div>
                        </div>

                        <a asp-controller="CustomerServices"
                           asp-action="Details"
                           asp-route-id="@service.Id"
                           class="btn btn-primary book-btn">

                            View Service

                        </a>

                    </div>

                </div>

            </div>
        }

    </div>


    <!-- Bottom message -->

    <div class="text-center mt-5 mb-5">

        <h4 class="fw-bold">
            Can't decide what you need?
        </h4>

        <p class="text-muted">
            Select a service to see available providers and booking options.
        </p>

    </div>

</div>