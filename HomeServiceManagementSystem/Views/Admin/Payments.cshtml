@model IEnumerable<HomeServiceManagementSystem.Models.Payment>

@{
    ViewData["Title"] = "Payment Management";
}

<style>
    body {
        background: #f5f8fc;
    }

    .page-wrapper {
        max-width: 1200px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .page-header {
        background: linear-gradient(135deg, #2563eb, #4f46e5);
        color: white;
        border-radius: 20px;
        padding: 30px;
        margin-bottom: 25px;
    }

    .page-header h1 {
        margin: 0;
        font-size: 30px;
        font-weight: 700;
    }

    .page-header p {
        margin: 8px 0 0;
        opacity: 0.9;
    }

    .payment-card {
        background: white;
        border-radius: 18px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.07);
        overflow: hidden;
    }

    .table-wrapper {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th {
        background: #f8fafc;
        padding: 16px;
        text-align: left;
        color: #374151;
        font-size: 14px;
    }

    td {
        padding: 16px;
        border-top: 1px solid #eef2f7;
        color: #4b5563;
    }

    .amount {
        font-weight: 700;
        color: #111827;
    }

    .paid {
        display: inline-block;
        background: #dcfce7;
        color: #15803d;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
    }

    .method {
        background: #eff6ff;
        color: #2563eb;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #6b7280;
    }

    .back-btn {
        display: inline-block;
        margin-top: 20px;
        padding: 11px 18px;
        background: #e5e7eb;
        color: #374151;
        text-decoration: none;
        border-radius: 10px;
        font-weight: 600;
    }
</style>

<div class="page-wrapper">

    <div class="page-header">
        <h1>💳 Payment Management</h1>
        <p>View and monitor customer payments.</p>
    </div>

    <div class="payment-card">

        @if (Model.Any())
        {
            <div class="table-wrapper">

                <table>
                    <thead>
                        <tr>
                            <th>Payment ID</th>
                            <th>Customer</th>
                            <th>Service</th>
                            <th>Provider</th>
                            <th>Amount</th>
                            <th>Method</th>
                            <th>Status</th>
                            <th>Date</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var payment in Model)
                        {
                            <tr>

                                <td>
                                    #@payment.Id
                                </td>

                                <td>
                                    @(payment.Booking?.User?.Name ?? "Unknown")
                                </td>

                                <td>
                                    @(payment.Booking?.Service?.Name ?? "Unknown")
                                </td>

                                <td>
                                    @(payment.Booking?.ServiceProvider?.User?.Name ?? "Unknown")
                                </td>

                                <td class="amount">
                                    ₹@payment.Amount.ToString("N2")
                                </td>

                                <td>
                                    <span class="method">
                                        @payment.PaymentMethod
                                    </span>
                                </td>

                                <td>
                                    <span class="paid">
                                        ✓ @payment.PaymentStatus
                                    </span>
                                </td>

                                <td>
                                    @payment.PaymentDate.ToString("dd MMM yyyy")
                                    <br />
                                    <small>
                                        @payment.PaymentDate.ToString("hh:mm tt")
                                    </small>
                                </td>

                            </tr>
                        }

                    </tbody>
                </table>

            </div>
        }
        else
        {
            <div class="empty-state">
                <div style="font-size:45px;">💳</div>

                <h3>No Payments Yet</h3>

                <p>
                    Customer payments will appear here after a payment is completed.
                </p>
            </div>
        }

    </div>

    <a asp-controller="Admin"
       asp-action="Index"
       class="back-btn">
        ← Back to Admin Dashboard
    </a>

</div>