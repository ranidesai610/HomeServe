@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-4">

    <h1 class="mb-2">Admin Dashboard</h1>

    <p class="text-muted">
        Manage the Home Service Management System
    </p>

    <hr />

    <div class="row mt-4">

        <div class="col-md-4 mb-3">
            <div class="card shadow h-100">
                <div class="card-body">
                    <h4>Users</h4>
                    <p>Manage system users.</p>

                    <a asp-controller="Users"
                       asp-action="Index"
                       class="btn btn-primary">
                        Manage Users
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow h-100">
                <div class="card-body">
                    <h4>Service Providers</h4>
                    <p>Manage service providers.</p>

                    <a asp-controller="ServiceProviders"
                       asp-action="Index"
                       class="btn btn-success">
                        Manage Providers
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow h-100">
                <div class="card-body">
                    <h4>Services</h4>
                    <p>Manage available services.</p>

                    <a asp-controller="Services"
                       asp-action="Index"
                       class="btn btn-warning">
                        Manage Services
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow h-100">
                <div class="card-body">
                    <h4>Bookings</h4>
                    <p>Manage customer bookings.</p>

                    <a asp-controller="Bookings"
                       asp-action="Index"
                       class="btn btn-info">
                        Manage Bookings
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow h-100">
                <div class="card-body">
                    <h4>Complaints</h4>
                    <p>View customer complaints.</p>
                    <a asp-controller="Complaints"
                       asp-action="Index"
                       class="btn btn-danger">
                        Manage Complaints
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow h-100">
                <div class="card-body">
                    <h4>Payments</h4>
                    <p>View payment information.</p>
                    <a asp-controller="Admin"
   asp-action="Payments"
   class="btn btn-secondary">
    Manage Payments
</a>
               
                </div>
            </div>
        </div>

        <div class="mt-4">
            <a asp-controller="Admin"
               asp-action="Logout"
               class="btn btn-dark">
                Logout
            </a>
        </div>

    </div>

</div>