@model IEnumerable<HomeServiceManagementSystem.Models.Complaint>

@{
    ViewData["Title"] = "Manage Complaints";
}

<style>
    .complaints-page {
        margin-top: 40px;
        margin-bottom: 60px;
    }

    .complaints-header {
        background: linear-gradient(135deg, #dc3545, #f06b78);
        color: white;
        border-radius: 24px;
        padding: 40px;
        margin-bottom: 30px;
    }

        .complaints-header h1 {
            font-weight: 800;
        }

    .complaint-card {
        background: white;
        border-radius: 20px;
        padding: 25px;
        margin-bottom: 20px;
        box-shadow: 0 8px 28px rgba(0,0,0,0.07);
        transition: 0.3s;
    }

        .complaint-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 14px 32px rgba(0,0,0,0.10);
        }

    .complaint-icon {
        width: 60px;
        height: 60px;
        border-radius: 17px;
        background: #fff1f1;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
    }

    .complaint-subject {
        font-size: 20px;
        font-weight: 800;
        color: #172033;
    }

    .customer-name {
        color: #0d6efd;
        font-weight: 700;
        margin-top: 5px;
    }

    .booking-info {
        color: #6c757d;
        margin-top: 5px;
    }

    .status-badge {
        display: inline-block;
        padding: 7px 14px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 700;
        background: #fff3cd;
        color: #856404;
    }

    .view-btn {
        border-radius: 10px;
        padding: 9px 18px;
        font-weight: 600;
    }

    .empty-box {
        background: white;
        border-radius: 22px;
        padding: 60px 20px;
        text-align: center;
        box-shadow: 0 8px 28px rgba(0,0,0,0.07);
    }

    .empty-icon {
        font-size: 55px;
    }
</style>

<div class="container complaints-page">

    <div class="complaints-header">

        <h1>⚠️ Manage Complaints</h1>

        <p class="mb-0 mt-2">
            Review and manage customer complaints and service issues.
        </p>

    </div>


    @if (!Model.Any())
    {
        <div class="empty-box">

            <div class="empty-icon">
                ✅
            </div>

            <h3 class="fw-bold mt-3">
                No Complaints
            </h3>

            <p class="text-muted">
                There are currently no customer complaints.
            </p>

        </div>
    }
    else
    {
        @foreach (var complaint in Model)
        {
            <div class="complaint-card">

                <div class="row align-items-center">

                    <div class="col-md-1">

                        <div class="complaint-icon">
                            ⚠️
                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="complaint-subject">
                            @complaint.Subject
                        </div>

                        <div class="customer-name">
                            👤 Customer:
                            @complaint.User?.Name
                        </div>

                    </div>


                    <div class="col-md-3">

                        <div class="booking-info">
                            🏠 Service:
                            @complaint.Booking?.Service?.Name
                        </div>

                        <div class="booking-info">
                            📋 Booking:
                            #@complaint.BookingId
                        </div>

                        <div class="booking-info">
                            📅
                            @complaint.CreatedAt.ToString("dd MMM yyyy")
                        </div>

                    </div>


                    <div class="col-md-2">

                        <div class="status-badge">
                            @complaint.Status
                        </div>

                    </div>


                    <div class="col-md-2 text-md-end mt-3 mt-md-0">

                        <a asp-action="Details"
                           asp-route-id="@complaint.Id"
                           class="btn btn-primary view-btn">

                            View Details →

                        </a>

                    </div>

                </div>

            </div>
        }
    }

</div>