@model HomeServiceManagementSystem.Models.Complaint

@{
    ViewData["Title"] = "Update Complaint";
}

<style>
    .edit-page {
        margin-top: 40px;
        margin-bottom: 60px;
    }

    .edit-header {
        background: linear-gradient(135deg, #f59f00, #ffc107);
        color: white;
        border-radius: 24px;
        padding: 40px;
        margin-bottom: 30px;
        text-align: center;
    }

        .edit-header h1 {
            font-weight: 800;
        }

    .edit-card {
        background: white;
        border-radius: 22px;
        padding: 35px;
        box-shadow: 0 8px 30px rgba(0,0,0,0.08);
    }

    .info-box {
        background: #f8f9fc;
        border-radius: 15px;
        padding: 20px;
        margin-bottom: 25px;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        padding: 10px 0;
    }

    .info-label {
        color: #6c757d;
        font-weight: 600;
    }

    .info-value {
        color: #172033;
        font-weight: 700;
        text-align: right;
    }

    .form-label {
        font-weight: 700;
        color: #172033;
    }

    .form-select {
        border-radius: 12px;
        padding: 12px;
    }

    .action-btn {
        border-radius: 12px;
        padding: 12px 22px;
        font-weight: 700;
    }
</style>

<div class="container edit-page">

    <div class="edit-header">

        <div style="font-size: 45px;">
            ⚙️
        </div>

        <h1>Update Complaint</h1>

        <p class="mb-0 mt-2">
            Update the current status of this customer complaint.
        </p>

    </div>


    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="edit-card">

                <div class="info-box">

                    <div class="info-row">

                        <span class="info-label">
                            Complaint ID
                        </span>

                        <span class="info-value">
                            #@Model.Id
                        </span>

                    </div>

                    <div class="info-row">

                        <span class="info-label">
                            Customer
                        </span>

                        <span class="info-value">
                            @Model.User?.Name
                        </span>

                    </div>

                    <div class="info-row">

                        <span class="info-label">
                            Subject
                        </span>

                        <span class="info-value">
                            @Model.Subject
                        </span>

                    </div>

                </div>


                <form asp-action="Edit" method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />

                    <div class="mb-4">

                        <label class="form-label">
                            Complaint Status
                        </label>

                        <select name="status"
                                class="form-select"
                                required>

                            <option value="Pending"
                                    selected="@(Model.Status == "Pending")">
                                Pending
                            </option>

                            <option value="In Progress"
                                    selected="@(Model.Status == "In Progress")">
                                In Progress
                            </option>

                            <option value="Resolved"
                                    selected="@(Model.Status == "Resolved")">
                                Resolved
                            </option>

                            <option value="Rejected"
                                    selected="@(Model.Status == "Rejected")">
                                Rejected
                            </option>

                        </select>

                    </div>


                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-warning action-btn">

                            💾 Update Status

                        </button>

                        <a asp-action="Details"
                           asp-route-id="@Model.Id"
                           class="btn btn-outline-secondary action-btn">

                            Cancel

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>